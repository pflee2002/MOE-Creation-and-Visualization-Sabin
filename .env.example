# Copy to .env and set the PostgreSQL connection.
# F5 loads .env through .vscode/launch.json.

DB_HOST=192.168.1.245
DB_PORT=5432
DB_USER=pflee2002
DB_PASSWORD=Engineering123!

# cv_dashboard holds the connected-vehicle table.
CV_DATABASE=cv_dashboard
CV_TABLE=georeferenced_trajectory_09_2025

# cv_static_data holds the short-link table. free_speed is the posted speed limit.
STATIC_DATABASE=cv_static_data
LINK_TABLE=TxDOT_all_roads_short_links

# OUTPUT_DIR=C:\path\to\Results\Network_MOE

# Blank PARALLEL_WORKERS uses (CPU cores - 2) on the machine running the script.
# PARALLEL_WORKERS=
SEGMENT_LENGTH_FT=500
TIME_BIN_MINUTES=15
SLOW_SPEED_THRESHOLD_MPH=5
